generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  password          String
  emailVerified     Boolean   @default(false)
  verificationToken String?  @unique
  resetToken        String?  @unique
  resetTokenExpiry  DateTime?
  wins              Int       @default(0)
  losses            Int       @default(0)
  draws             Int       @default(0)
  gamesPlayed       Int       @default(0)
  winStreak         Int       @default(0)
  maxWinStreak      Int       @default(0)
  unlockedBadges    String    @default("[]")
  unlockedEmotes    String    @default("[]")
  unlockedMilestones String   @default("[]")
  jamesonCurryGames  Int      @default(0)
  firstPickWins      Int      @default(0)
  firstPickGames     Int      @default(0)
  equippedBadge     String    @default("")
  equippedBadges    String    @default("[]")
  equippedEmote     String    @default("")
  tokenVersion      Int       @default(0)
  usernameChanges   Int       @default(0)
  createdAt         DateTime  @default(now())
  gameRecords       GameRecord[]

  @@index([gamesPlayed, wins(sort: Desc)])
  @@index([wins(sort: Desc), gamesPlayed])
}

model GameRecord {
  id             String   @id @default(cuid())
  userId         String
  opponentName   String
  opponentId     String?
  result         String   // 'win' | 'loss' | 'draw'
  mySeriesScore  Int
  oppSeriesScore Int
  teamMode       String
  series         Int
  source         String   // 'online' | 'friends'
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// Persists auction results to the DB at the moment finishAuction fires.
// The results JSON mirrors the AuctionResult[] sent to clients so the
// server can serve the results page even after a restart within the 30-min
// review window.  Rows are retained for 48 h then can be pruned.
model AuctionRecord {
  id          String   @id @default(cuid())
  code        String   @unique
  teamSize    Int
  totalBudget Int
  results     String   // JSON-serialised AuctionResult[]
  completedAt DateTime @default(now())

  @@index([completedAt(sort: Desc)])
}

model Player {
  id          Int     @id
  firstName   String
  lastName    String
  team        String
  position    String
  positions   String
  careerGames Int
  careerPPG   Float
  careerRPG   Float
  careerAPG   Float
  careerMPG   Float   @default(0)
  yearFrom    Int     @default(0)
  yearTo      Int     @default(0)
  ebkScore    Float   @default(0)
  ebkGpScore  Float   @default(0)
  ebkPpgScore Float   @default(0)
  ebkRpgScore Float   @default(0)
  ebkApgScore Float   @default(0)
  ebkMpgScore   Float   @default(0)
  careerEarnings Float   @default(0)   // real scraped career earnings (0 = not yet scraped / pre-salary-era)
  wikiViews      Float   @default(0)   // total Wikipedia pageviews (0 = not yet fetched)

  @@index([yearFrom])
}
