generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  password          String
  emailVerified     Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  wins              Int       @default(0)
  losses            Int       @default(0)
  draws             Int       @default(0)
  gamesPlayed       Int       @default(0)
  winStreak         Int       @default(0)
  maxWinStreak      Int       @default(0)
  unlockedBadges    String    @default("[]")
  unlockedEmotes    String    @default("[]")
  unlockedMilestones String   @default("[]")
  jamesonCurryGames  Int      @default(0)
  equippedBadge     String    @default("")
  equippedEmote     String    @default("")
  createdAt         DateTime  @default(now())
}

model Player {
  id          Int     @id
  firstName   String
  lastName    String
  team        String
  position    String
  positions   String
  careerGames Int
  careerPPG   Float
  careerRPG   Float
  careerAPG   Float
  careerMPG   Float   @default(0)
  yearFrom    Int     @default(0)
  yearTo      Int     @default(0)
  ebkScore    Float   @default(0)
  ebkGpScore  Float   @default(0)
  ebkPpgScore Float   @default(0)
  ebkRpgScore Float   @default(0)
  ebkApgScore Float   @default(0)
  ebkMpgScore Float   @default(0)
}
