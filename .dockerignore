# Dependencies — reinstalled inside Docker
node_modules

# Git history — not needed in image
.git
.gitignore

# Environment files — secrets must come from Railway Variables, never baked in
.env
.env.*
.env.local
.env.development
.env.production

# Logs
*.log
npm-debug.log*

# Build output — rebuilt during Docker build
dist/
.next/

# Dev / editor noise
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Test artifacts
coverage/
