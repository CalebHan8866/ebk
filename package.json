{
  "name": "ebk",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node --project tsconfig.server.json server.ts",
    "build:server": "tsc --project tsconfig.server.json",
    "build:_WARN_accept-data-loss": "DANGER: --accept-data-loss silently drops columns/tables removed from schema.prisma. Before any schema change that REMOVES a field, verify the migration is purely additive or use prisma migrate deploy instead.",
    "build": "rm -rf .next && prisma db push --accept-data-loss || true && prisma generate && ts-node --project tsconfig.seed.json scripts/patch-missing-players.ts || true && ts-node --project tsconfig.seed.json scripts/update-season.ts 2025 || true && ts-node --project tsconfig.seed.json scripts/update-season.ts 2026 || true && next build && npm run build:server",
    "start": "NODE_ENV=production node dist/server.js",
    "db:push": "prisma db push",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "scrape": "ts-node --project tsconfig.seed.json scripts/scrape-bbref.ts",
    "scrape:seasons": "ts-node --project tsconfig.seed.json scripts/scrape-season-data.ts",
    "scrape:salaries": "ts-node --project tsconfig.seed.json scripts/scrape-salaries.ts",
    "scrape:salaries:fix": "REFETCH=1 ts-node --project tsconfig.seed.json scripts/scrape-salaries.ts",
    "scrape:wiki": "ts-node --project tsconfig.seed.json scripts/scrape-popularity.ts",
    "scrape:all": "ts-node --project tsconfig.seed.json scripts/scrape-all.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.16.2",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "jose": "^5.6.3",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.32.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "prisma": "^5.16.2",
    "tailwindcss": "^3.4.1",
    "vitest": "^2.1.0"
  }
}
