# ─── Required ────────────────────────────────────────────────────────────────

# Prisma connection string (Railway Postgres URL in production; file:./dev.db for local SQLite)
DATABASE_URL="file:./dev.db"

# Secret used to sign JWT session tokens — use a long random string in production
JWT_SECRET="replace-me-with-a-long-random-secret"

# ─── Strongly recommended in production ──────────────────────────────────────

# Public URL of the app — used for Socket.IO CORS and email links
APP_URL="http://localhost:3000"

# Base URL used by Next.js sitemap and robots.txt (defaults to https://ebkgame.com)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ─── Optional ─────────────────────────────────────────────────────────────────

# Node environment — set to "production" on Railway
NODE_ENV="development"

# Port the Express/Socket.IO server listens on (defaults to 3000)
PORT="3000"

# Dev-only bypass secret for the /api/auth/dev-verify endpoint
DEV_SECRET="replace-me-with-a-random-hex-string"

# Comma-separated user IDs that bypass the 30-min rematch cooldown (for automated testing)
NOCOOLDOWN_USER_IDS=""

# ─── Email ────────────────────────────────────────────────────────────────────
# Option A — Resend (preferred for production)
# API key from https://resend.com — leave blank to fall back to SMTP or console logging
RESEND_API_KEY=""

# Option B — SMTP — leave blank to use console logging in development
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL=""
